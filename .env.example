# ─── Deepgram (STT) ───
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── LLM (any OpenAI-compatible endpoint) ───
# Examples:
#   OpenRouter:  https://openrouter.ai/api/v1   (model: anthropic/claude-3-haiku)
#   Bedrock Mantle / vLLM / Ollama / LiteLLM:   set base_url + model accordingly
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL_ID=anthropic/claude-3-haiku

# ─── Cartesia (TTS) ───
CARTESIA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CARTESIA_VOICE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Redis (Session State) ───
REDIS_URL=redis://localhost:6379/0

# ─── Server ───
SERVER_HOST=your-ngrok-url.ngrok-free.app
PORT=8000
LOG_LEVEL=INFO

# ─── Agent ───
MAX_TOOL_CALLS_PER_TURN=5
KNOWLEDGE_BASE_PATH=./knowledge.json